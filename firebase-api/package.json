{
  "name": "fitai-api",
  "private": true,
  "main": "lib/index.cjs",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "build": "npm run check && esbuild index.ts --bundle --platform=node --target=node22 --format=cjs --packages=external --outfile=lib/index.cjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "firebase-functions": "^6.4.0",
    "openai": "^4.82.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "typescript": "~5.8.2"
  }
}
