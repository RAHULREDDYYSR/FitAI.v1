# Server-only. Set securely in environment settings or an ignored .env.local.
# The managed cloud proxy binding must target api.openai.com.
# Never prefix API credentials with VITE_ or add them to vite.config.ts.
FITAI_OPENAI_API_KEY=

# Low-cost OpenAI API default; override if your account uses a different model.
FITAI_COACH_MODEL=gpt-5-nano

# Node 24.5+: honor the cloud platform HTTPS proxy with native fetch.
NODE_USE_ENV_PROXY=1
