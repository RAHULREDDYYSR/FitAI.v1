# Server-only. Set securely in environment settings or an ignored .env.local.
# The managed cloud proxy binding must target api.openai.com.
# Never prefix API credentials with VITE_ or add them to vite.config.ts.
FITAI_OPENAI_API_KEY=

# Public API model ID; requires access on your OpenAI API account.
FITAI_COACH_MODEL=gpt-6-luna

# Node 24.5+: honor the cloud platform HTTPS proxy with native fetch.
NODE_USE_ENV_PROXY=1

# Public URL only, for a separate backend. Leave empty for the local Node API.
# Example: https://your-project-ref.supabase.co/functions/v1/fitai-api
VITE_COACH_API_URL=

# Server/Edge only: comma-separated browser origins, including custom domains.
FITAI_ALLOWED_ORIGINS=https://gen-lang-client-0375724084.web.app,https://gen-lang-client-0375724084.firebaseapp.com,http://localhost:3000
